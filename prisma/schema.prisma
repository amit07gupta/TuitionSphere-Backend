generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TUTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  noticesCreated Notice[]     @relation("NoticeCreatedBy")
  noticesUpdated Notice[]     @relation("NoticeUpdatedBy")
  noticesRead    NoticeRead[]

  assignmentsUpdated Assignment[] @relation("AssignmentUpdatedBy")

  attendanceMarked Attendance[]
  leavesReviewed   LeaveRequest[]

  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  phone                   String?                @unique
  tutor                   Tutor?
  student                 Student?
  paymentsReceived        Payment[]              @relation("PaymentReceivedBy")
  paymentReportsReviewed  StudentPaymentReport[] @relation("PaymentReportReviewedBy")
  sessionVersion          Int                    @default(0)
  avatar                  String?
  notificationPreferences Json                   @default("{}")
  themePreference         ThemePreference        @default(SYSTEM)
  sessions                AdminSession[]
  passwordHash            String
  role                    UserRole
  status                  UserStatus             @default(ACTIVE)
  lastLoginAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model AdminSession {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent      String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  sessionVersion Int

  @@index([userId])
  @@map("admin_sessions")
}

model AcademicSession {
  id             String                @id @default(cuid())
  name           String                @unique
  startDate      DateTime
  endDate        DateTime
  status         AcademicSessionStatus @default(UPCOMING)
  batches        Batch[]
  feePlans       FeePlan[]
  demoSetups     DemoSetup[]
  admissions     Admission[]
  classSchedules ClassSchedule[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
  @@index([startDate, endDate])
  @@map("academic_sessions")
}

enum GradeStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model Board {
  id           String           @id @default(uuid())
  name         String
  code         String           @unique
  description  String?
  status       String           @default("ACTIVE")
  grades       GradeBoard[]
  tutors       TutorBoard[]
  subjects     Subject[]
  batches      Batch[]
  demoSetups   DemoSetupBoard[]
  demoRequests DemoRequest[]
  admissions   Admission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("boards")
}

model Grade {
  notices Notice[]

  id            String         @id @default(cuid())
  gradeName     String
  numericValue  Int            @unique
  learningStage String
  status        GradeStatus    @default(ACTIVE)
  boards        GradeBoard[]
  tutors        TutorGrade[]
  subjects      SubjectGrade[]
  batches       Batch[]
  feePlans      FeePlan[]
  demoSetups    DemoSetup[]
  demoRequests  DemoRequest[]
  admissions    Admission[]
  inquiries     Inquiry[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("grades")
}

model GradeBoard {
  id        String   @id @default(cuid())
  gradeId   String
  boardId   String
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gradeId, boardId])
  @@index([gradeId])
  @@index([boardId])
  @@map("grade_boards")
}

model Subject {
  assignments Assignment[]

  id             String          @id @default(cuid())
  name           String
  code           String
  status         SubjectStatus   @default(ACTIVE)
  streams        String[]        @default([])
  boardId        String
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Restrict)
  grades         SubjectGrade[]
  tutors         TutorSubject[]
  batches        BatchSubject[]
  classSchedules ClassSchedule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([boardId, code])
  @@index([boardId])
  @@index([status])
  @@map("subjects")
}

model SubjectGrade {
  id        String   @id @default(cuid())
  subjectId String
  gradeId   String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([subjectId, gradeId])
  @@index([subjectId])
  @@index([gradeId])
  @@map("subject_grades")
}

enum TutorStatus {
  ACTIVE
  INACTIVE
}

model Tutor {
  assignments Assignment[]
  notices     Notice[]

  id            String      @id @default(cuid())
  userId        String      @unique
  employeeCode  String      @unique
  designation   String
  qualification String?
  experience    Int?
  availability  String
  modes         String[]    @default([])
  streams       String[]    @default([])
  joiningDate   DateTime
  status        TutorStatus @default(ACTIVE)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  boards         TutorBoard[]
  grades         TutorGrade[]
  subjects       TutorSubject[]
  batches        BatchSubject[]
  demoSetups     DemoSetup[]
  classSchedules ClassSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("tutors")
}

model TutorBoard {
  id      String @id @default(cuid())
  tutorId String
  boardId String

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tutorId, boardId])
  @@index([tutorId])
  @@index([boardId])
  @@map("tutor_boards")
}

model TutorGrade {
  id      String @id @default(cuid())
  tutorId String
  gradeId String

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tutorId, gradeId])
  @@index([tutorId])
  @@index([gradeId])
  @@map("tutor_grades")
}

model TutorSubject {
  id        String @id @default(cuid())
  tutorId   String
  subjectId String

  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tutorId, subjectId])
  @@index([tutorId])
  @@index([subjectId])
  @@map("tutor_subjects")
}

enum BatchStatus {
  ACTIVE
  INACTIVE
}

enum LearningMode {
  ONLINE
  OFFLINE
}

model Batch {
  notices Notice[]

  assignments Assignment[]

  leaveRequests LeaveRequest[]

  id                String       @id @default(cuid())
  name              String
  academicSessionId String
  gradeId           String
  boardId           String
  stream            String?
  learningMode      LearningMode @default(OFFLINE)
  capacity          Int
  status            BatchStatus  @default(ACTIVE)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  grade           Grade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  board           Board           @relation(fields: [boardId], references: [id], onDelete: Restrict)
  subjects        BatchSubject[]
  admissions      Admission[]
  classSchedules  ClassSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicSessionId, name])
  @@index([academicSessionId])
  @@index([gradeId])
  @@index([boardId])
  @@index([learningMode])
  @@index([status])
  @@map("batches")
}

enum ScheduleType {
  SINGLE
  RECURRING
}

enum ClassScheduleStatus {
  SCHEDULED
  CANCELLED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ClassSchedule {
  attendance Attendance[]

  id                String              @id @default(cuid())
  academicSessionId String
  batchId           String
  subjectId         String
  tutorId           String
  scheduleType      ScheduleType        @default(SINGLE)
  topic             String?
  startDate         DateTime
  endDate           DateTime
  repeatDays        Weekday[]           @default([])
  startTime         String
  endTime           String
  learningMode      LearningMode
  location          String?
  meetingUrl        String?
  status            ClassScheduleStatus @default(SCHEDULED)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  batch           Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  tutor           Tutor           @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicSessionId])
  @@index([batchId])
  @@index([subjectId])
  @@index([tutorId])
  @@index([startDate, endDate])
  @@index([status])
  @@map("class_schedules")
}

model BatchSubject {
  id        String @id @default(cuid())
  batchId   String
  subjectId String
  tutorId   String

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([batchId, subjectId])
  @@index([batchId])
  @@index([subjectId])
  @@index([tutorId])
  @@map("batch_subjects")
}

enum FeePlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  FULL_SESSION
}

model FeePlan {
  id                String           @id @default(cuid())
  name              String
  academicSessionId String
  gradeId           String
  admissionFee      Decimal          @db.Decimal(12, 2)
  tuitionFee        Decimal          @db.Decimal(12, 2)
  billingFrequency  BillingFrequency
  installments      Int
  dueDay            Int
  lateFee           Decimal          @default(0) @db.Decimal(12, 2)
  gracePeriodDays   Int              @default(0)
  effectiveFrom     DateTime
  effectiveTo       DateTime
  status            FeePlanStatus    @default(DRAFT)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  grade           Grade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  admissions      Admission[]
  invoices        Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicSessionId, gradeId])
  @@index([academicSessionId])
  @@index([gradeId])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@map("fee_plans")
}

enum DemoSetupStatus {
  ACTIVE
  INACTIVE
}

model DemoSetup {
  id                String          @id @default(cuid())
  name              String
  academicSessionId String
  tutorId           String
  gradeId           String
  stream            String?
  mode              LearningMode    @default(OFFLINE)
  demoStartDate     DateTime
  demoEndDate       DateTime
  availableDays     String[]        @default([])
  status            DemoSetupStatus @default(ACTIVE)

  academicSession AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  tutor           Tutor            @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  grade           Grade            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  boards          DemoSetupBoard[]
  timeSlots       DemoSlot[]
  requests        DemoRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicSessionId, name])
  @@index([academicSessionId])
  @@index([tutorId])
  @@index([gradeId])
  @@index([mode])
  @@index([status])
  @@index([demoStartDate, demoEndDate])
  @@map("demo_setups")
}

model DemoSetupBoard {
  id          String @id @default(cuid())
  demoSetupId String
  boardId     String

  demoSetup DemoSetup @relation(fields: [demoSetupId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([demoSetupId, boardId])
  @@index([demoSetupId])
  @@index([boardId])
  @@map("demo_setup_boards")
}

model DemoSlot {
  id          String @id @default(cuid())
  demoSetupId String
  startTime   String
  endTime     String
  capacity    Int

  demoSetup DemoSetup     @relation(fields: [demoSetupId], references: [id], onDelete: Cascade)
  requests  DemoRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demoSetupId, startTime, endTime])
  @@index([demoSetupId])
  @@map("demo_slots")
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  CONFIRMED
  ADMISSION_STARTED
  ENROLLED
  CANCELLED
}

model DemoRequest {
  id          String            @id @default(cuid())
  studentName String
  parentName  String
  email       String
  phone       String
  demoDate    DateTime
  status      DemoRequestStatus @default(NEW)

  demoSetupId String
  demoSlotId  String
  gradeId     String
  boardId     String
  stream      String?

  demoSetup DemoSetup  @relation(fields: [demoSetupId], references: [id], onDelete: Restrict)
  demoSlot  DemoSlot   @relation(fields: [demoSlotId], references: [id], onDelete: Restrict)
  grade     Grade      @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Restrict)
  admission Admission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, demoDate, demoSlotId])
  @@unique([phone, demoDate, demoSlotId])
  @@index([demoSetupId, demoDate])
  @@index([demoSlotId, demoDate])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("demo_requests")
}

enum StudentProfileStatus {
  INCOMPLETE
  COMPLETE
}

enum AdmissionStatus {
  ENROLLED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

model Student {
  profileRequests       StudentProfileRequest[]
  assignmentSubmissions AssignmentSubmission[]
  paymentReports        StudentPaymentReport[]

  attendance    Attendance[]
  leaveRequests LeaveRequest[]

  id               String               @id @default(cuid())
  studentCode      String               @unique
  userId           String               @unique
  parentName       String
  parentPhone      String
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  relationship     String?
  emergencyContact String?
  profileStatus    StudentProfileStatus @default(INCOMPLETE)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  admissions Admission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentPhone])
  @@index([profileStatus])
  @@map("students")
}

model StudentProfileRequest {
  id        String   @id @default(cuid())
  studentId String
  field     String
  details   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_profile_requests")
}

model Admission {
  id                String          @id @default(cuid())
  studentId         String
  demoRequestId     String?         @unique
  academicSessionId String
  gradeId           String
  boardId           String
  batchId           String
  feePlanId         String
  source            String
  joiningDate       DateTime
  status            AdmissionStatus @default(ENROLLED)

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  demoRequest     DemoRequest?    @relation(fields: [demoRequestId], references: [id], onDelete: Restrict)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  grade           Grade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  board           Board           @relation(fields: [boardId], references: [id], onDelete: Restrict)
  batch           Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  feePlan         FeePlan         @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  invoices        Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicSessionId])
  @@index([academicSessionId])
  @@index([gradeId])
  @@index([boardId])
  @@index([batchId])
  @@index([feePlanId])
  @@index([status])
  @@map("admissions")
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  admissionId       String
  feePlanId         String
  installmentNumber Int
  title             String
  amount            Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  lateFeeAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  dueDate           DateTime
  status            InvoiceStatus @default(PENDING)

  admission      Admission              @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  feePlan        FeePlan                @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  payments       Payment[]
  paymentReports StudentPaymentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([admissionId, installmentNumber])
  @@index([admissionId])
  @@index([feePlanId])
  @@index([dueDate])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id                   String      @id @default(cuid())
  receiptNumber        String      @unique
  invoiceId            String
  amount               Decimal     @db.Decimal(12, 2)
  paymentMode          PaymentMode
  transactionReference String?
  paymentDate          DateTime    @default(now())
  notes                String?
  receivedById         String?

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([receivedById])
  @@index([paymentDate])
  @@map("payments")
}

enum StudentPaymentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model StudentPaymentReport {
  id                   String                     @id @default(cuid())
  invoiceId            String
  studentId            String
  amount               Decimal                    @db.Decimal(12, 2)
  paymentMode          PaymentMode
  paymentDate          DateTime
  transactionReference String
  proofName            String
  proofData            Bytes
  note                 String?
  status               StudentPaymentReportStatus @default(PENDING)
  reviewNote           String?
  reviewedById         String?
  reviewedAt           DateTime?

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("PaymentReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, status])
  @@index([studentId, createdAt])
  @@index([reviewedById])
  @@map("student_payment_reports")
}

enum InquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP_REQUIRED
  READY_FOR_ADMISSION
  CLOSED
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  phone         String
  email         String?
  gradeId       String
  inquiryType   String
  message       String?
  contactMethod String
  preferredTime String
  learningMode  String
  status        InquiryStatus @default(NEW)
  followUpNote  String?

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gradeId])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("inquiries")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Attendance {
  id              String           @id @default(cuid())
  studentId       String
  classScheduleId String
  date            DateTime         @db.Date
  status          AttendanceStatus
  markedById      String
  leaveRequestId  String?
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classSchedule   ClassSchedule    @relation(fields: [classScheduleId], references: [id], onDelete: Restrict)
  markedBy        User             @relation(fields: [markedById], references: [id], onDelete: Restrict)
  leaveRequest    LeaveRequest?    @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([studentId, classScheduleId, date])
  @@index([date])
  @@map("attendance")
}

model LeaveRequest {
  id              String             @id @default(cuid())
  studentId       String
  batchId         String
  fromDate        DateTime           @db.Date
  toDate          DateTime           @db.Date
  type            String
  reason          String
  status          LeaveRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch           Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  reviewedBy      User?              @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  attendance      Attendance[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([studentId, fromDate, toDate])
  @@index([status])
  @@map("leave_requests")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  REVIEWED
}

model Assignment {
  id                 String                 @id @default(cuid())
  title              String
  type               String                 @default("Homework")
  instructions       String                 @default("")
  batchId            String
  subjectId          String
  tutorId            String
  dueDate            DateTime               @db.Date
  totalMarks         Int
  status             AssignmentStatus       @default(DRAFT)
  archivedFromStatus AssignmentStatus?
  attachmentName     String?
  attachmentData     Bytes?
  adminUpdatedById   String?
  batch              Batch                  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  subject            Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  tutor              Tutor                  @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  adminUpdatedBy     User?                  @relation("AssignmentUpdatedBy", fields: [adminUpdatedById], references: [id], onDelete: Restrict)
  submissions        AssignmentSubmission[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([batchId, subjectId])
  @@index([tutorId])
  @@index([status, dueDate])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String                     @id @default(cuid())
  assignmentId String
  studentId    String
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  fileName     String?
  fileData     Bytes?
  marks        Int?
  feedback     String?
  submittedAt  DateTime                   @default(now())
  reviewedAt   DateTime?
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student      Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  updatedAt    DateTime                   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

enum NoticeCategory {
  ACADEMIC
  SCHEDULE
  EXAM
  FEE
  GENERAL
}

enum NoticePriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NoticeAudience {
  ALL
  GRADE
  BATCH
  TUTORS
  TUTOR
  EVERYONE
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Notice {
  id           String         @id @default(cuid())
  title        String
  message      String
  category     NoticeCategory @default(ACADEMIC)
  priority     NoticePriority @default(NORMAL)
  audienceType NoticeAudience @default(ALL)
  gradeId      String?
  batchId      String?
  tutorId      String?
  publishDate  DateTime       @db.Date
  expiryDate   DateTime?      @db.Date
  status       NoticeStatus   @default(DRAFT)
  createdById  String
  updatedById  String
  grade        Grade?         @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  batch        Batch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  tutor        Tutor?         @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User           @relation("NoticeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  reads        NoticeRead[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, publishDate, expiryDate])
  @@index([gradeId])
  @@index([batchId])
  @@index([tutorId])
  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(cuid())
  userId   String
  noticeId String
  readAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([noticeId])
  @@map("notice_reads")
}
